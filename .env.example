# ─── Frontend (Vercel / local .env) ───
# Public Render backend URL — no trailing slash
VITE_API_URL=https://your-backend.onrender.com

# Supabase (public anon key — safe for browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Backend (Render / local server/.env) ───
OPENAI_API_KEY=sk-your-openai-key
PORT=3001
NODE_ENV=production

# Comma-separated origins allowed to call the API (your Vercel app URL)
# Example: https://workflowgpt.vercel.app,https://workflowgpt-git-main-user.vercel.app
CORS_ORIGIN=https://your-frontend.vercel.app

# Optional alias for a single frontend URL
FRONTEND_URL=https://your-frontend.vercel.app

# Supabase (server-side service role — never expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Telegram ID of app owner — always gets role "owner" on every login
# Production: set your real Telegram numeric ID (e.g. from @userinfobot)
# Local dev outside Telegram: use 999999999 to match the built-in dev user
OWNER_TELEGRAM_ID=999999999

# Telegram Bot API token (@BotFather) — powers /start welcome message
TELEGRAM_BOT_TOKEN=

# Public Mini App URL opened from the bot welcome button (no trailing slash)
WEBAPP_URL=https://your-frontend.vercel.app
